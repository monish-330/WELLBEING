# Server Configuration
PORT=5001
NODE_ENV=production

# Database Configuration (Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.8cyerw3.mongodb.net/studentmentalhealth?retryWrites=true&w=majority&appName=Cluster0
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=10

# Security Secrets
JWT_SECRET=your_ultra_secure_jwt_secret_key_here
JOURNAL_SECRET=your_ultra_secure_aes_journal_key_here

# Concurrency / Rate Limiting (Optimized for 2,000+ concurrent students)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5000
