{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend/backend",
      "framework": "express",
      "entrypoint": "server.js"
    },
    "frontend": {
      "root": "frontend/frontend",
      "framework": "vite",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://wellbeing-backend-764z.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://wellbeing-backend-764z.onrender.com/uploads/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "https://wellbeing-backend-764z.onrender.com/images/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/assets/$1"
      }
    },
    {
      "source": "/(.*\\.(?:ico|png|jpg|jpeg|svg|css|js|json|webmanifest|woff|woff2|ttf|eot))",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      }
    }
  ]
}
